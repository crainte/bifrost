[
  {kernel, [
    {shell_history, enabled},
    {logger, [
      {handler, default, logger_std_h, #{
        config => #{type => standard_io},
        formatter => {logger_formatter, #{
          template => [time, " ", level, " ", module, ": ", msg, "\n"]
        }}
      }}
    ]},
    {logger_level, info}
  ]},
  {mnesia, [
    {dir, "/var/lib/bifrost/mnesia"}
  ]}
].
