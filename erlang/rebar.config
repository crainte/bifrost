{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"},
    {jsx, "3.0.0"},
    {epgsql, "4.8.0"}
]}.

%% Test config. EUnit for pure logic, Common Test for integration (real Postgres
%% + a running node). Both ship with rebar3/OTP — no extra deps.
{eunit_opts, [verbose]}.
{ct_opts, [{sys_config, "./config/test.sys.config"}]}.
{cover_enabled, true}.
{dialyzer, [{warnings, [unknown]}]}.

{relx, [
    {release, {bifrost, "0.2.2"}, [bifrost, inets, ssl, mnesia]},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"},
    {dev_mode, false},
    {include_erts, false}
]}.
